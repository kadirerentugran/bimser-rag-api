# bimser-api

# Veritabanı
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DB_NAME

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

